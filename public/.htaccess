ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS obrigatório (o teste do cabeçalho X-Forwarded-Proto evita laço de redirecionamento atrás de proxy).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Página de produto com prévia (p/<id>.html, criada pelo GoSync). Se ainda não existir,
  # abre o aplicativo normal do site, que carrega o produto pelo endereço.
  RewriteCond %{DOCUMENT_ROOT}/p/$1.html -f
  RewriteRule ^p/([A-Za-z0-9-]+)/?$ /p/$1.html [L]
  RewriteRule ^p/([A-Za-z0-9-]+)/?$ /produto/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Dados do ERP: sempre revalidar (o app da bandeja atualiza a cada 15 min)
  <FilesMatch "catalog\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  # Assets do build e fotos têm hash no nome: cache longo
  <FilesMatch "\.(js|css|woff2|jpg|jpeg|png|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/html text/css application/javascript image/svg+xml
</IfModule>

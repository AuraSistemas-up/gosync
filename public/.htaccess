ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_headers.c>
  # Dados do ERP: sempre revalidar (o app da bandeja atualiza a cada 15 min)
  <FilesMatch "catalog\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  # Assets do build e fotos têm hash no nome: cache longo
  <FilesMatch "\.(js|css|woff2|jpg|jpeg|png|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/html text/css application/javascript
</IfModule>

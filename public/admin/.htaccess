# Nunca expor credenciais/tentativas
<FilesMatch "\.(json|tmp[0-9a-f]*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "no-store"
  Header set X-Frame-Options "DENY"
</IfModule>

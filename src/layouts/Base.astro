---
import "../styles/global.css";
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand" aria-label="Início">
          <img id="brandLogo" class="brand-logo" alt="" hidden />
          <div class="logo-placeholder" id="brandMono">S</div>
          <span class="company-name" id="companyName">Sapataria</span>
        </a>
        <form action="/" method="get" role="search" class="search-wrap">
          <label for="q" class="sr-only">Buscar calçados</label>
          <input id="q" name="q" type="search" placeholder="Buscar por modelo, marca ou referência…" autocomplete="off" />
          <button type="submit" aria-label="Buscar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </form>
      </div>
    </header>
    <slot />
  </body>
</html>

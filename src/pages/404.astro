---
import Base from "../layouts/Base.astro";
---
<Base title="Não encontrado | Sapataria">
  <div class="product-wrap">
    <div class="empty-state">
      <h1 style="margin:0 0 6px;color:var(--text)">Página não encontrada</h1>
      <p style="margin:0">O calçado pode ter esgotado ou saído do catálogo.</p>
      <a href="/" class="btn-whatsapp" style="margin-top:16px;padding:10px 20px;border-radius:999px;background:linear-gradient(135deg,var(--primary),var(--primary-dark))">Ver catálogo</a>
    </div>
  </div>
</Base>

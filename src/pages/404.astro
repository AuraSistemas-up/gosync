---
import Base from "../layouts/Base.astro";
---
<Base title="Não encontrado | Sapataria">
  <main class="mx-auto max-w-md px-4 py-16 text-center">
    <h1 class="text-2xl font-bold">Calçado não encontrado</h1>
    <p class="mt-2 text-stone-600">Ele pode ter esgotado ou saído do catálogo.</p>
    <a href="/" class="mt-5 inline-block rounded-lg bg-stone-900 px-4 py-2 text-white">Ver catálogo</a>
  </main>
</Base>

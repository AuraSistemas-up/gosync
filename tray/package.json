{
  "name": "gosync",
  "productName": "GoSync",
  "version": "1.0.23",
  "description": "GoSync: sincroniza ERP → Locaweb (bandeja do relógio)",
  "author": "AuraSistemas-up",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "node scripts/prepare-site.js && electron-builder --win nsis --publish never",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "electron-updater": "^6.3.9",
    "iconv-lite": "^0.7.3",
    "node-firebird-driver-native": "^3.7.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "br.com.gosync.app",
    "productName": "GoSync",
    "artifactName": "GoSync-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "ui/**",
      "assets/**",
      "!**/node_modules/node-firebird-native-api/{src,build/Release/*.{exp,iobj,ipdb,lib,pdb,obj,ilk},build/*.{vcxproj,sln,tlog},binding.gyp}"
    ],
    "extraResources": [
      {
        "from": "site-dist",
        "to": "site"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "AuraSistemas-up",
      "repo": "gosync"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-firebird-native-api/build/Release/*.node"
    ]
  }
}
